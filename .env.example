# Oriane API (https://connect.oriane.xyz/rest/docs). Put the real value in Replit Secrets or .env.local.
# Several comma-separated keys are allowed: the next key is used when one runs out of credits.
ORIANE_API_KEY=
ORIANE_BASE_URL=https://connect.oriane.xyz
# Hard cap on uncached Oriane calls per pipeline run (budget guard).
ORIANE_MAX_CALLS_PER_RUN=40

# LLM used for structure extraction and wording only (never for scores).
# LLM_PROVIDER: groq | gemini | anthropic | openai
# LLM_API_KEY may hold several comma-separated keys (separate accounts = separate rate limits).
LLM_PROVIDER=
LLM_API_KEY=
# Optional. If empty, a model is picked from the provider's live model list.
LLM_MODEL=

# 1 = never call external APIs, serve from the disk cache only (stage demo with Wi-Fi off).
PREFLIGHT_OFFLINE=0
